# --- CatalystSoft / Click2Pick CustomerRestAPI (booking & tracking) ---
# UAT example base (no trailing slash required; server normalizes):
# LOGISTICS_API_BASE_URL=http://dev.CatalystSoft.in/CustomerRestAPI/API/v1
LOGISTICS_API_BASE_URL=
# Required header value from provider (keep secret — never commit real value to git)
LOGISTICS_X_APP_KEY=
LOGISTICS_CUSTOMER_CODE=
LOGISTICS_AGENT_CODE=
LOGISTICS_PASSWORD=
# 1 = test/UAT bookings, 0 = live
LOGISTICS_IS_TESTING=1
# Values must match provider lists (Get_ModeList / Get_ProductList). Examples:
LOGISTICS_DEFAULT_MODE_NAME=STANDARD
LOGISTICS_DEFAULT_PRODUCT_NAME=PARCEL
# Fallback weight (kg) when booking from an order (no per-SKU weight on Order yet)
LOGISTICS_DEFAULT_WEIGHT_KG=1
# Ship-from (consignor) — your warehouse / pickup location
LOGISTICS_CONSIGNOR_PINCODE=
LOGISTICS_CONSIGNOR_NAME=
LOGISTICS_CONSIGNOR_ADDRESS1=
LOGISTICS_CONSIGNOR_ADDRESS2=
