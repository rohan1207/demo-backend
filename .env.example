# --- CatalystSoft / Click2Pick CustomerRestAPI (booking & tracking) ---
# UAT example base (no trailing slash required; server normalizes):
# LOGISTICS_API_BASE_URL=http://dev.CatalystSoft.in/CustomerRestAPI/API/v1
LOGISTICS_API_BASE_URL=
# Optional: axios timeout for Catalyst (ms). Increase on slow networks.
# LOGISTICS_HTTP_TIMEOUT_MS=90000
LOGISTICS_HTTP_TIMEOUT_MS=90000

# Required header value from provider (keep secret — never commit real value to git)
LOGISTICS_X_APP_KEY=
LOGISTICS_CUSTOMER_CODE=
LOGISTICS_AGENT_CODE=
LOGISTICS_PASSWORD=

# 1 = test/UAT bookings, 0 = live
LOGISTICS_IS_TESTING=1
# 1 = verbose request/response logs in backend console, 0 = quiet
LOGISTICS_DEBUG=0
LOGISTICS_DEFAULT_MODE_NAME=
LOGISTICS_DEFAULT_PRODUCT_NAME=
LOGISTICS_DEFAULT_WEIGHT_KG=1
LOGISTICS_CONSIGNOR_PINCODE=
LOGISTICS_CONSIGNOR_NAME=
LOGISTICS_CONSIGNOR_ADDRESS1=
LOGISTICS_CONSIGNOR_ADDRESS2=

# --- Resend (transactional email: order confirmation, status updates, contact form) ---
# Get API key: https://resend.com/api-keys
# RESEND_FROM_EMAIL must use a domain you verified in Resend (e.g. "T-REX <orders@yourdomain.com>").
# Without a verified domain, Resend only allows their sandbox sender to limited recipients.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Shown as Reply-To on order emails; contact form replies go to the visitor’s email automatically.
RESEND_REPLY_TO=thetrexstore.support@gmail.com

# Inbox where contact form submissions are delivered.
MAIL_ADMIN_INBOX=thetrexstore.support@gmail.com

# Optional: links in emails (e.g. “View orders”). No trailing slash.
FRONTEND_PUBLIC_URL=https://thetrexstore.com

# Optional display name in email subjects / bodies
STORE_PUBLIC_NAME=T-REX Store
